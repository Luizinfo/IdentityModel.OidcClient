<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ZinfoFramework.IdentityModel" Version="[10.0.0]" />
    <PackageReference Include="ZinfoFramework.IdentityModel.OidcClient" Version="[10.0.0]" />
    <PackageReference Include="ZinfoFramework.IdentityModel.OidcClient.DPoP" Version="[10.0.0]" />
    <PackageReference Include="ZinfoFramework.IdentityModel.OidcClient.IdentityTokenValidator" Version="[10.0.0]" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1" PrivateAssets="All" />
  </ItemGroup>

</Project>
